#!/usr/bin/env bash
# CalibMI command-line entry point.
#
#   ./calibmi <command>
#
# Commands that need only the artifacts in results/ are marked [offline].
# Commands that need the raw EEG datasets on disk are marked [raw].
set -euo pipefail
cd "$(dirname "$0")"
export MPLCONFIGDIR="${MPLCONFIGDIR:-$PWD/.mplconfig}"
PY="${PYTHON:-python}"

usage() {
  cat <<'USAGE'
CalibMI

  ./calibmi check        [offline] verify the Python environment imports
  ./calibmi audit        [offline] leakage audit: refuse any artifact whose
                                   eval_labels_used_for_selection is set or missing
  ./calibmi report       [offline] regenerate results/.../fm_audit/REPORT.md
  ./calibmi decompose    [offline] regenerate the matched-input decomposition
  ./calibmi multiplicity [offline] regenerate the multiplicity tables
  ./calibmi contrasts    [offline] matched-input intervals, paired contrasts,
                                   and raw-versus-scaled calibration
  ./calibmi readout      [offline] rebuild merged comparisons, paired deltas,
                                   bootstrap CIs and Wilcoxon tests
  ./calibmi figures      [offline] protocol schematic, learning curves, and the
                                   paper figures (--prob-root for reliability)
  ./calibmi power        [offline] detection rate vs cohort size, by resampling
                                   the 54-subject cohort
  ./calibmi manifest     [offline] SHA256 reproducibility manifest
  ./calibmi tables       [offline] audit + report + decompose + multiplicity +
                                   contrasts + power + manifest

  ./calibmi smoke        [raw]     short code-path check before long runs
  ./calibmi full         [raw]     full validation-locked retraining (slow)
  ./calibmi reliability  [raw]     reliability diagrams from per-trial probabilities
  ./calibmi edge         [raw]     int8 quantization: does the validation-fitted
                                   temperature survive on-device precision?
                                   needs requirements-edge.txt and a checkpoint

Per-trial probability archives are not in this repository because of their size;
`reliability` and the reliability figure need them under results/.
USAGE
}

case "${1:-}" in
  check)
    $PY -c "import mne, moabb, sklearn, scipy, pandas; print('core ok')"
    $PY -c "import torch; print('torch', torch.__version__)"
    ;;
  audit)        $PY src/scripts/audit_leakage_fields.py --results-dir results ;;
  report)       $PY src/scripts/make_fm_audit_report.py ;;
  decompose)    $PY src/scripts/make_preprocessing_decomposition.py ;;
  multiplicity) $PY src/scripts/make_multiplicity_table.py ;;
  contrasts)    $PY src/scripts/make_matched_input_contrasts.py ;;
  readout)      bash reproducibility/01_readout_from_saved_results.sh ;;
  figures)
    bash reproducibility/04_protocol_schematic.sh
    $PY src/scripts/make_paper_figures.py "${@:2}"
    $PY src/scripts/make_learning_curve_figure.py || echo "learning curves need results/fm_probe_curves"
    ;;
  power)        $PY src/scripts/make_subsampling_power.py "${@:2}" ;;
  manifest)
    $PY src/scripts/make_reproducibility_manifest.py \
        --results-dir results --out results/reproducibility_manifest.json
    ;;
  tables)
    "$0" audit && "$0" report && "$0" decompose && "$0" multiplicity && "$0" contrasts && "$0" power && "$0" manifest
    echo "tables rebuilt from saved artifacts; no model was retrained."
    ;;
  smoke)        bash reproducibility/00_smoke_test.sh ;;
  full)         bash reproducibility/02_full_validation_locked_runs.sh ;;
  reliability)  bash reproducibility/03_reliability_figures_from_probabilities.sh ;;
  edge)         $PY src/scripts/edge_quantize_eval.py "${@:2}" ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 2 ;;
esac
